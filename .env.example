# ─────────────────────────────────────────────────────────────
# Rumo — variáveis de ambiente
# Copie para .env.local e preencha o que quiser usar.
# Nada aqui é obrigatório: sem chaves, o app usa serviços
# abertos do OpenStreetMap (mapa, rotas, busca e lugares).
# ─────────────────────────────────────────────────────────────

# E-mail de contato enviado no User-Agent para os serviços OSM
# (exigido pelas políticas de uso do Nominatim/Overpass/OSRM).
APP_CONTACT_EMAIL=

# ── Rotas a pé / bicicleta / carro ───────────────────────────
# Padrão: servidores OSRM da FOSSGIS (routing.openstreetmap.de).
# Para produção com tráfego alto, hospede seu próprio OSRM ou use Mapbox.
OSRM_BASE_URL=https://routing.openstreetmap.de

# Se definida, Mapbox Directions/Matrix substitui o OSRM (servidor).
MAPBOX_ACCESS_TOKEN=

# ── Transporte público ───────────────────────────────────────
# Necessária para rotas de transporte público (linhas, paradas,
# baldeações). Habilite a "Routes API" no Google Cloud.
GOOGLE_MAPS_API_KEY=

# ── Busca e pontos de interesse ──────────────────────────────
PHOTON_BASE_URL=https://photon.komoot.io
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── Mapa (cliente) ───────────────────────────────────────────
# Opcional: estilo de tiles do Mapbox no navegador (token público pk.*).
NEXT_PUBLIC_MAPBOX_TOKEN=
# Opcional: URL de tiles XYZ personalizada (substitui CARTO Voyager).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
